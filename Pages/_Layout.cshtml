@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@functions {
    private string Versioned(string path) => FileVersions.AddFileVersionToPath(Context.Request.PathBase, Context.Request.PathBase + path);
}
<!DOCTYPE html>
<html class="light" lang="@CultureInfo.CurrentCulture.Name" dir="@(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@(Context.Request.PathBase.HasValue ? Context.Request.PathBase + "/" : "/")" />
    <style>
        @@font-face {
            font-family: 'Material Symbols Outlined';
            font-style: normal;
            font-weight: 400;
            font-display: swap;
            src: url('fonts/material-symbols-outlined.ttf') format('truetype');
        }
    </style>
    <script src="@Versioned("/js/theme-mode.js")"></script>
    <link href="@Versioned("/css/roboto.css")" rel="stylesheet" />
    <link href="@Versioned("/css/site.css")" rel="stylesheet" />
    <link href="@Versioned("/css/rtl.css")" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body class="bg-surface font-body text-on-surface antialiased">
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled error has occurred. See browser console for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">X</a>
    </div>

    <script src="~/_framework/blazor.server.js"></script>
</body>
</html>
