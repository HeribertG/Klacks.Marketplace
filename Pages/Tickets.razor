@page "/tickets"
@using System.Globalization
@inject ITicketService TicketService
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Tickets_Title"] - Klacks Store</PageTitle>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <h1 class="text-3xl font-black tracking-tight">
            <span class="material-symbols-outlined text-3xl mr-2 align-middle">support_agent</span> @L["Tickets_Title"]
        </h1>
        @if (_isAuthenticated)
        {
            <a href="@TicketConstants.NewTicketRoute" class="px-6 py-3 bg-secondary text-on-secondary rounded-lg font-semibold no-underline hover:bg-secondary-container transition-all">
                <span class="material-symbols-outlined text-[18px] mr-1 align-middle">add</span> @L["Tickets_NewTicket"]
            </a>
        }
    </div>

    @if (!_isAuthenticated)
    {
        <div class="bg-secondary-fixed text-on-secondary-fixed-variant rounded-xl px-6 py-4">
            @L["Tickets_LoginRequired"] <a href="login" class="text-secondary hover:underline no-underline font-medium">@L["Common_LoginLink"]</a>
        </div>
    }
    else
    {
        <p class="text-on-surface-variant mb-6">@L["Tickets_Intro"]</p>

        @if (_isAdmin)
        {
            <div class="flex flex-wrap gap-2 mb-6">
                <button class="px-5 py-2 rounded-full font-bold transition-all @FilterClass(null)" @onclick="() => SetFilter(null)">@L["Tickets_FilterAll"]</button>
                <button class="px-5 py-2 rounded-full font-bold transition-all @FilterClass(TicketStatus.Open)" @onclick="() => SetFilter(TicketStatus.Open)">@L["Ticket_Status_Open"]</button>
                <button class="px-5 py-2 rounded-full font-bold transition-all @FilterClass(TicketStatus.Answered)" @onclick="() => SetFilter(TicketStatus.Answered)">@L["Ticket_Status_Answered"]</button>
                <button class="px-5 py-2 rounded-full font-bold transition-all @FilterClass(TicketStatus.Closed)" @onclick="() => SetFilter(TicketStatus.Closed)">@L["Ticket_Status_Closed"]</button>
            </div>
        }

        @if (_isLoading)
        {
            <div class="py-16 text-center">
                <div class="animate-spin inline-block w-8 h-8 border-4 border-secondary border-t-transparent rounded-full"></div>
            </div>
        }
        else if (_tickets.Count == 0)
        {
            <div class="py-16 text-center">
                <span class="material-symbols-outlined text-6xl text-on-surface-variant mb-4 block">support_agent</span>
                <h3 class="text-xl font-bold mb-2">@L["Tickets_NoTickets"]</h3>
                <p class="text-on-surface-variant">@L["Tickets_NoTicketsDesc"]</p>
            </div>
        }
        else
        {
            <div class="bg-surface-container-lowest rounded-xl overflow-x-auto shadow-[0_4px_12px_rgba(22,24,29,0.04)]">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-surface-container-low text-on-surface-variant text-xs uppercase tracking-wider">
                            <th class="px-6 py-4 text-left font-bold">@L["Tickets_Subject"]</th>
                            @if (_isAdmin)
                            {
                                <th class="px-6 py-4 text-left font-bold">@L["Tickets_Requester"]</th>
                            }
                            <th class="px-6 py-4 text-left font-bold">@L["Common_Status"]</th>
                            <th class="px-6 py-4 text-left font-bold">@L["Tickets_Updated"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/20">
                        @foreach (var ticket in _tickets)
                        {
                            <tr class="hover:bg-surface-container-low/50 transition-colors">
                                <td dir="auto" class="px-6 py-4 break-words"><a href="@TicketConstants.TicketsRoute/@ticket.Id" class="text-secondary hover:underline no-underline font-medium">@ticket.Subject</a></td>
                                @if (_isAdmin)
                                {
                                    <td class="px-6 py-4 break-words">@ticket.User.DisplayName</td>
                                }
                                <td class="px-6 py-4"><TicketStatusBadge Status="@ticket.Status" /></td>
                                <td class="px-6 py-4 whitespace-nowrap">@FormatDate(ticket.UpdatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private const string ActiveFilterClass = "bg-secondary text-on-secondary";
    private const string InactiveFilterClass = "bg-surface-container text-on-surface-variant hover:bg-surface-container-high";
    private const string DateFormat = "g";
    private const string UtcSuffix = " UTC";

    private List<Ticket> _tickets = [];
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _isLoading = true;
    private int _userId;
    private TicketStatus? _filter;

    protected override async Task OnInitializedAsync()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        _isAuthenticated = (user?.Identity?.IsAuthenticated ?? false)
            && int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _userId);
        _isAdmin = user?.IsInRole("Admin") ?? false;

        if (_isAuthenticated)
        {
            await Load();
        }

        _isLoading = false;
    }

    private async Task Load()
    {
        _tickets = _isAdmin
            ? await TicketService.GetAllTicketsAsync(_filter)
            : await TicketService.GetUserTicketsAsync(_userId);
    }

    private async Task SetFilter(TicketStatus? status)
    {
        _filter = status;
        _isLoading = true;
        await Load();
        _isLoading = false;
    }

    private string FilterClass(TicketStatus? status) => _filter == status ? ActiveFilterClass : InactiveFilterClass;

    private static string FormatDate(DateTime utc) => utc.ToString(DateFormat, CultureInfo.CurrentCulture) + UtcSuffix;
}
