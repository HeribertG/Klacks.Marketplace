@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<nav class="sticky top-0 w-full z-50 bg-surface-container-lowest/80 backdrop-blur-md shadow-sm font-sans antialiased tracking-tight text-sm font-medium">
    <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3 sm:py-4 max-w-7xl mx-auto">
        <div class="flex items-center gap-2 min-w-0">
            <svg class="w-6 h-6 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.406 6.736C20.767 6.897 21 7.255 21 7.65V16.412C21 16.775 20.803 17.109 20.486 17.286L12.486 21.73C12.184 21.898 11.816 21.898 11.514 21.73L3.514 17.286C3.197 17.109 3 16.775 3 16.412V7.65C3 7.255 3.233 6.897 3.594 6.736L11.594 3.181C11.852 3.066 12.148 3.066 12.406 3.181L20.406 6.736Z" fill="currentColor" opacity="0.3"/>
                <polygon fill="currentColor" points="14.967 4.224 7.6 8.317 7.6 12.906 9.6 13.906 9.6 9.494 17.255 5.241"/>
            </svg>
            <a href="." class="text-lg sm:text-xl font-bold tracking-tighter text-primary no-underline whitespace-nowrap">Klacks Store</a>
        </div>
        <div class="hidden xl:flex items-center gap-8">
            <a class="text-secondary font-semibold border-b-2 border-secondary py-1 transition-all no-underline" href=".">@L["Nav_Browse"]</a>
        </div>
        <div class="flex items-center gap-2 sm:gap-4">
            <CultureSelector />
            <div class="hidden xl:flex items-center gap-4">
                @AccountLinks("")
            </div>
            <button type="button"
                    class="xl:hidden p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-all"
                    aria-label="@L["Nav_Menu"]"
                    aria-expanded="@(_menuOpen ? "true" : "false")"
                    @onclick="ToggleMenu">
                <span class="material-symbols-outlined">@(_menuOpen ? "close" : "menu")</span>
            </button>
        </div>
    </div>

    @if (_menuOpen)
    {
        <div class="mobile-nav-panel xl:hidden absolute top-full inset-x-0 bg-surface-container-lowest shadow-xl border-t border-surface-container-high">
            <div class="flex flex-col gap-1 px-4 sm:px-6 py-4 max-w-7xl mx-auto">
                <a class="py-3 text-secondary font-semibold no-underline" href="." @onclick="CloseMenu">@L["Nav_Browse"]</a>
                @AccountLinks("py-3 w-full")
            </div>
        </div>
    }
</nav>

@code {
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _menuOpen;
    private string _displayName = string.Empty;

    private const string LinkClass = "text-on-surface-variant hover:text-secondary-container transition-colors font-medium no-underline flex items-center gap-1";

    protected override void OnInitialized()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        _isAuthenticated = user?.Identity?.IsAuthenticated ?? false;
        _isAdmin = user?.IsInRole("Admin") ?? false;
        _displayName = user?.Identity?.Name ?? string.Empty;
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private RenderFragment AccountLinks(string extraClass) => @<text>
        @if (_isAuthenticated)
        {
            <a class="@LinkClass @extraClass" href="upload" @onclick="CloseMenu">
                <span class="material-symbols-outlined text-[18px]">language</span> @L["Nav_UploadPack"]
            </a>
            <a class="@LinkClass @extraClass" href="upload-plugin" @onclick="CloseMenu">
                <span class="material-symbols-outlined text-[18px]">extension</span> @L["Nav_UploadPlugin"]
            </a>
            <a class="@LinkClass @extraClass" href="upload-region" @onclick="CloseMenu">
                <span class="material-symbols-outlined text-[18px]">public</span> @L["Nav_UploadRegion"]
            </a>
            <a class="@LinkClass @extraClass" href="my-packages" @onclick="CloseMenu">
                <span class="material-symbols-outlined text-[18px]">inventory_2</span> @L["Nav_MyPackages"]
            </a>
            @if (_isAdmin)
            {
                <a class="@LinkClass @extraClass" href="admin" @onclick="CloseMenu">
                    <span class="material-symbols-outlined text-[18px]">shield</span> @L["Nav_Admin"]
                </a>
            }
            <span class="text-on-surface-variant font-medium break-all @extraClass">@_displayName</span>
            <a class="px-0 xl:px-4 py-2 @LinkClass" href="auth/logout">@L["Nav_SignOut"]</a>
        }
        else
        {
            <a class="px-0 xl:px-4 py-2 @LinkClass" href="login" @onclick="CloseMenu">@L["Nav_SignIn"]</a>
            <a class="px-5 py-2 bg-secondary text-on-secondary rounded-lg font-semibold hover:bg-secondary-container active:scale-[0.98] transition-all no-underline text-center" href="register" @onclick="CloseMenu">@L["Nav_Register"]</a>
        }
    </text>;
}
