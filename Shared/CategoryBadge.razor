<span class="px-3 py-1 text-xs font-bold rounded-full @GetCategoryClasses()">@Category</span>

@code {
    [Parameter]
    public string Category { get; set; } = string.Empty;

    private string GetCategoryClasses() => Category?.ToLowerInvariant() switch
    {
        "communication" => "bg-category-communication text-on-category-communication",
        "erp" => "bg-category-erp text-on-category-erp",
        "accounting" => "bg-category-accounting text-on-category-accounting",
        "reporting" => "bg-category-reporting text-on-category-reporting",
        "integration" => "bg-category-integration text-on-category-integration",
        _ => "bg-surface-container-highest text-on-surface-variant"
    };
}
